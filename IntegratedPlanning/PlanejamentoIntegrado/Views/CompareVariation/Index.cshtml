@{
    ViewData["Title"] = "Compara Variação";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<ol class="breadcrumb float-xl-end">
    <li class="breadcrumb-item active">Compara Variação</li>
</ol>

<h1 class="page-header">
    <span class="fas fa-desktop"></span>&nbsp;&nbsp;Dashboard Compara Variação
</h1>

<!-- BEGIN row -->
<div class="row">				
    <!-- BEGIN col-12 -->
    <div class="col-lg-12">					
        <!-- BEGIN panel -->
        <div class="panel panel-inverse">
            <!-- BEGIN panel-heading -->
            <div class="panel-heading">
                <h4 class="panel-title">Filtros</h4>
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i class="fa fa-minus"></i></a>
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i class="fa fa-expand"></i></a>
                </div>					
            </div>
            <!-- END panel-heading -->						
            
            <!-- BEGIN panel-body -->
            <div class="panel-body">
                <h4 class="text-center">Filtrar Resultados</h4>
                <form asp-action="Index" method="POST">								
                        
                    <div class="row mb-15px">
                        
                        <div class="col-md-6">
                            <label class="form-label" for="SupplierCode">FORNECEDOR</label>
                            <select class="default-select2 form-control" id="SupplierCode" name="SupplierCode">
                                <option value="">SELECIONE</option>
                                @if (ViewBag.Suppliers != null)
                                {
                                    foreach (var supplier in ViewBag.Suppliers)
                                    {
                                        var displayName = $"{supplier.SupplierName} - {supplier.Neighborhood}, {supplier.City}";
                                        <option value="@supplier.SupplierCode">@displayName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="PartId">PEÇA</label>
                            <select class="default-select2 form-control" id="PartId" name="PartId">
                                <option value="">SELECIONE</option>
                                @if (ViewBag.Parts != null)
                                {
                                    foreach (var part in ViewBag.Parts)
                                    {
                                        <option value="@part">@part</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>								
                    
                    
                    <div class="row mb-15px">									
                        <div class="col-md-6">
                            <label class="form-label" for="ModelId">MODELO</label>
                            <select class="default-select2 form-control" id="ModelId" name="ModelIds" multiple="multiple" data-placeholder="SELECIONE">
                                @if (ViewBag.Models != null)
                                {
                                    foreach (var modelItem in ViewBag.Models)
                                    {
                                        <option value="@modelItem">@modelItem</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="StartDate">PERÍODO DE DEMANDA</label>
                            <div class="col-lg-12">
                                <div class="input-group input-daterange">
                                    <input type="text" class="form-control" id="StartDate" name="StartDate" placeholder="Data Inicial" />
                                    <span class="input-group-text input-group-addon">à</span>
                                    <input type="text" class="form-control" id="EndDate" name="EndDate" placeholder="Data Final" />
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row mb-15px">
                        <div class="col-md-6"></div>
                        <div class="col-md-6">
                            <label class="form-label" for="CreationStartDate">PERÍODO DE CRIAÇÃO</label>
                            <div class="col-lg-12">
                                <div class="input-group input-daterange">
                                    <input type="text" class="form-control" id="CreationStartDate" name="CreationStartDate" placeholder="Data Inicial" />
                                    <span class="input-group-text input-group-addon">à</span>
                                    <input type="text" class="form-control" id="CreationEndDate" name="CreationEndDate" placeholder="Data Final" />
                                </div>
                            </div>
                        </div>
                    </div>								
                    
                    <br/>
                    <div class="form-group text-center">
                        <label class="form-label">&nbsp;</label>
                        <div class="col-lg-12">
                            <button class="btn btn-primary" type="button" id="btnLimpar">Limpar</button>
                            <button type="button" class="btn btn-primary" id="btnFiltrar">Filtrar</button>
                        </div>
                    </div>	
                    
                </form>							
            </div>
            <!-- END panel-body -->
            
        </div>
        <!-- END panel -->
    <!-- END col-12 -->
    </div>
    
                    
    
    <!-- BEGIN col-12 -->
    <div class="col-lg-12">	
        
        
        <!-- BEGIN panel -->
        <div class="panel panel-inverse">
            <!-- BEGIN panel-heading -->
            <div class="panel-heading">
                <h4 class="panel-title">Resultado da Busca</h4>
                <div class="panel-heading-btn">
                    <a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i class="fa fa-expand"></i></a>
                </div>					
            </div>
            <!-- END panel-heading -->						
            
            <!-- BEGIN panel-body -->
            <div class="panel-body" style="position: relative; min-height: 400px;">
                <!-- Loading Overlay -->
                <div id="loading-overlay" style="display: none; position: absolute; top: 0; left: 0; right: 0; bottom: 0; width: 100%; height: 100%; min-height: 400px; background-color: rgba(255, 255, 255, 0.9); z-index: 1000; align-items: center; justify-content: center;">
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Carregando...</span>
                        </div>
                        <p class="mt-3" style="font-size: 16px; font-weight: 500;">Carregando dados...</p>
                    </div>
                </div>
                                    
                <table id="data-table-buttons" width="100%" class="table table-striped table-bordered align-middle text-nowrap">
                    <thead>
                        <tr>
                            <th width="15%" class="text-nowrap">Peça</th>
                            <th width="30%" class="text-nowrap">Fornecedor</th>
                            <th width="10%" class="text-nowrap text-center">Valor Unit.</th>
                            <th width="15%" class="text-nowrap text-center">Qtd. Demanda</th>
                            <th width="10%" class="text-nowrap text-center">Valor Total</th>
                            <th width="10%" class="text-nowrap text-center">Tipo</th>
                            <th width="10%" class="text-nowrap text-center">Variação</th>
                            <th width="10%" class="text-nowrap text-center">Detalhe</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
            <!-- END panel-body -->
        </div>
        <!-- END panel -->				
        
        <!-- END row -->				
    </div>
</div>
<!-- END row -->

@section Scripts {
    <script>
        $(document).ready(function () {
            // Funções para controlar o loading
            function showLoading() {
                $('#loading-overlay').css('display', 'flex');
            }
            
            function hideLoading() {
                $('#loading-overlay').hide();
            }
            
            $('.default-select2').select2();
            
            $('.input-daterange input').each(function() {
                $(this).datepicker({
                    format: 'dd/mm/yyyy',
                    autoclose: true,
                    language: 'pt-BR'
                });
            });
            
            function convertDateToISO(dateString) {
                if (!dateString) return null;
                var parts = dateString.split('/');
                return parts[2] + '-' + parts[1] + '-' + parts[0];
            }
            
            function getFilters() {
                var filters = {
                    supplierCode: $('#SupplierCode').val() || null,
                    modelIds: $('#ModelId').val() || [],
                    partId: $('#PartId').val() || null,
                    startDate: $('#StartDate').val() || null,
                    endDate: $('#EndDate').val() || null,
                    creationStartDate: $('#CreationStartDate').val() || null,
                    creationEndDate: $('#CreationEndDate').val() || null
                };
                
                console.log('getFilters() retornou:', filters);
                return filters;
            }

            var shouldLoadData = false;
            var emptyStateMessage = 'Nenhum dado disponível. Utilize os filtros para iniciar a busca.';

            var table = $('#data-table-buttons').DataTable({
                processing: true,
                serverSide: true,
                ajax: function (d, callback) {
                    if (!shouldLoadData) {
                        callback({
                            draw: d.draw,
                            recordsTotal: 0,
                            recordsFiltered: 0,
                            data: []
                        });
                        hideLoading();
                        return;
                    }

                    var filters = getFilters();

                    showLoading();

                    $.ajax({
                        url: '/CompareVariation/GetData',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            search: d.search,
                            order: d.order,
                            supplierCode: filters.supplierCode,
                            modelIds: filters.modelIds,
                            partId: filters.partId,
                            startDate: filters.startDate,
                            endDate: filters.endDate,
                            creationStartDate: filters.creationStartDate,
                            creationEndDate: filters.creationEndDate
                        }),
                        success: function (response) {
                            callback(response);
                        },
                        error: function (xhr, error) {
                            console.error('Erro ao carregar dados:', error);
                            alert('Erro ao carregar dados. Por favor, tente novamente.');
                            callback({
                                draw: d.draw,
                                recordsTotal: 0,
                                recordsFiltered: 0,
                                data: []
                            });
                        },
                        complete: function () {
                            hideLoading();
                        }
                    });
                },
                columns: [
                    { 
                        data: 'productCode'
                    },
                    { data: 'supplierName' },
                    { 
                        data: 'unitValue',
                        render: function(data) {
                            return data != null ? data.toFixed(2).replace('.', ',') : '0,00';
                        },
                        className: 'text-end'
                    },
                    { 
                        data: 'demandQuantity',
                        render: function(data) {
                            return data != null ? Math.round(data).toLocaleString('pt-BR') : '0';
                        },
                        className: 'text-end'
                    },
                    { 
                        data: 'totalValue',
                        render: function(data) {
                            return data != null ? data.toFixed(2).replace('.', ',') : '0,00';
                        },
                        className: 'text-end'
                    },
                    { 
                        data: 'itemType',
                        className: 'text-center'
                    },
                    { 
                        data: 'variation',
                        render: function(data) {
                            if (data === 0) {
                                return '<span class="text-danger fas fa-arrow-up"></span>';
                            } else if (data === 1) {
                                return '<span class="text-info fas fa-arrow-down"></span>';
                            } else {
                                return '<span class="text-muted fas fa-minus"></span>';
                            }
                        },
                        className: 'text-center',
                        orderable: false
                    },
                    { 
                        data: 'inventoryItemId',
                        render: function(data, type, row) {
                            return '<button type="button" class="btn btn-white btn-rounded btn-condensed btn-sm btn-view-details" data-id="' + data + '">' +
                                   '<span class="text-info fa fa-eye"></span>' +
                                   '</button>';
                        },
                        className: 'text-center',
                        orderable: false
                    }
                ],
                pageLength: 10,
                lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                dom: '<"row mb-3"<"col-md-6"B><"col-md-6"fr>>t<"row mt-3"<"col-md-auto me-md-auto"i><"col-md-auto ms-md-auto"p>>',
                buttons: [
                    { extend: 'copy', className: 'btn-sm' },
                    { extend: 'csv', className: 'btn-sm' },
                    { extend: 'excel', className: 'btn-sm' },
                    { extend: 'pdf', className: 'btn-sm' },
                    { extend: 'print', className: 'btn-sm' }
                ],
                language: {
                    url: '/assets/data/datatables-pt-BR.json',
                    processing: 'Carregando...',
                    emptyTable: emptyStateMessage
                },
                order: [[4, 'desc']]
            });
            
            $('#btnLimpar').on('click', function() {
                $('#SupplierCode').val('').trigger('change');
                $('#ModelId').val(null).trigger('change');
                $('#PartId').val('').trigger('change');
                $('#StartDate').val('');
                $('#EndDate').val('');
                $('#CreationStartDate').val('');
                $('#CreationEndDate').val('');
                
                shouldLoadData = false;
                table.ajax.reload(null, false);
            });
            
            $('#btnFiltrar').on('click', function() {
                shouldLoadData = true;
                table.ajax.reload();
            });
            
            $('form').on('submit', function(e) {
                e.preventDefault();
                $('#btnFiltrar').click();
            });
            
            $(document).on('click', '.btn-view-details', function() {
                var id = $(this).data('id');
                var filters = getFilters();
                var url = '/CompareVariation/Details/' + id;
                
                console.log('Clique no botão Ver - ID:', id);
                console.log('Filtros atuais:', filters);
                
                var params = [];
                if (filters.supplierCode) params.push('supplierName=' + encodeURIComponent(filters.supplierCode));
                if (filters.modelIds && filters.modelIds.length > 0) params.push('model=' + encodeURIComponent(filters.modelIds.join(',')));
                if (filters.startDate) params.push('startDate=' + encodeURIComponent(convertDateToISO(filters.startDate)));
                if (filters.endDate) params.push('endDate=' + encodeURIComponent(convertDateToISO(filters.endDate)));
                if (filters.creationStartDate) params.push('creationStartDate=' + encodeURIComponent(convertDateToISO(filters.creationStartDate)));
                if (filters.creationEndDate) params.push('creationEndDate=' + encodeURIComponent(convertDateToISO(filters.creationEndDate)));
                
                if (params.length > 0) {
                    url += '?' + params.join('&');
                }
                
                console.log('URL final:', url);
                window.location.href = url;
            });
        });
    </script>
}

