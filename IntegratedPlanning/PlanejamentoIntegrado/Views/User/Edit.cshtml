@model PlanejamentoIntegrado.Models.UserViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Editar Usuário";
}

<ol class="breadcrumb float-xl-end">
    <li class="breadcrumb-item"><a asp-controller="CompareVariation" asp-action="Index">Início</a></li>
    <li class="breadcrumb-item"><a asp-action="Index">Cadastro de Usuários</a></li>
    <li class="breadcrumb-item active">Editar Usuário</li>
</ol>

<h1 class="page-header">
    <span class="fas fa-user"></span>&nbsp;&nbsp;Editar Usuário
</h1>

<div class="panel panel-default">
    <div class="panel-body">
        <div class="row">
            <div class="col-md-4"></div>
            <div class="col-md-4">
                <h3 class="text-center">Dados do Usuário</h3>
                <form asp-action="Edit" method="post" class="form-horizontal" data-parsley-validate="true">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label class="form-label">Nome do Usuário</label>
                        <input asp-for="Name" class="form-control" placeholder="Insira o Nome do Usuário" data-parsley-required="true" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sobrenome</label>
                        <input asp-for="Surname" class="form-control" placeholder="Sobrenome do Usuário" data-parsley-required="true" />
                        <span asp-validation-for="Surname" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">E-mail</label>
                        <input asp-for="Email" class="form-control" placeholder="E-mail do Usuário" data-parsley-required="true" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Login de Acesso</label>
                        <input asp-for="Login" class="form-control" placeholder="Login do Usuário" data-parsley-required="true" />
                        <span asp-validation-for="Login" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nova Senha (deixe em branco para não alterar)</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Nova senha (opcional)" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Perfil do Usuário</label>
                        <select asp-for="ProfileId" class="form-select" data-parsley-required="true">
                            <option value="">SELECIONE</option>
                            <option value="0">ADMINISTRADOR</option>
                            <option value="1">VISUALIZADOR</option>
                        </select>
                        <span asp-validation-for="ProfileId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Ativo</label>
                        <select asp-for="IsActive" class="form-select">
                            <option value="true">Sim</option>
                            <option value="false">Não</option>
                        </select>
                        <span asp-validation-for="IsActive" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="ReceivesEmail" class="form-check-input" type="checkbox" />
                        <label asp-for="ReceivesEmail" class="form-check-label">Receber e-mail</label>
                    </div>

                    <div class="form-group text-center">
                        <div class="col-lg-12">
                            <a asp-action="Index" class="btn btn-primary">Voltar</a>
                            <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="col-md-4"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/plugins/parsleyjs/dist/parsley.min.js"></script>
    <script src="~/assets/plugins/parsleyjs/dist/i18n/pt-br.js"></script>
    <script>
        Parsley.setLocale('pt-br');
    </script>
}
